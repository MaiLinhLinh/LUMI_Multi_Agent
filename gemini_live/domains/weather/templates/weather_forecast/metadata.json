{
  "id": "weather_forecast",
  "kind": "complete_template",
  "domain": "weather",
  "name": "Multi-day Weather Forecast",
  "description": "Compact multi-day forecast with first-day summary, daily temperature chart and day cards.",
  "template_file": "template.html",
  "visual_stage_map_file": "visual_stage_map.txt",
  "schema_versions": ["weather.forecast.v1", "weather.combined.v1"],
  "required_fields": [
    "location.name",
    "forecast.days[].date",
    "forecast.days[].intervals[].temperature_celsius"
  ],
  "optional_fields": [
    "location.country",
    "forecast.source_granularity",
    "forecast.days[].temperature.min_celsius",
    "forecast.days[].temperature.max_celsius",
    "forecast.days[].max_rain_probability",
    "forecast.days[].total_rain_mm",
    "forecast.days[].condition.description",
    "forecast.days[].temperature_feels_like_celsius",
    "forecast.days[].humidity_percent",
    "forecast.days[].pressure_hpa",
    "forecast.days[].wind_speed_mps",
    "forecast.days[].intervals[].time",
    "forecast.days[].intervals[].condition.description",
    "forecast.days[].intervals[].rain_probability"
  ],
  "tags": ["weather", "forecast", "multi-day", "temperature-chart"],
  "fillable": true,
  "style_targets": [
    {
      "id": "page_background",
      "label": "nền toàn trang",
      "selector": "body",
      "properties": ["background_color"]
    },
    {
      "id": "forecast_header",
      "label": "vùng tiêu đề phía trên",
      "selector": ".page-header",
      "properties": ["background_color"]
    },
    {
      "id": "forecast_content",
      "label": "vùng nội dung dự báo",
      "selector": ".page",
      "properties": ["background_color"]
    }
  ],
  "presentation_capabilities": {
    "overview": {"target_id": "weather.overview", "anchor_id": "a", "allowed_effects": ["highlight", "draw_circle"]},
    "day_summary": {"target_pattern": "weather.day.{day_index}.summary", "entity_fields": ["day_index"], "anchor_id_pattern": "h{day_number}", "allowed_effects": ["highlight", "draw_circle"]},
    "temperature": {"target_id": "weather.day.0.temperature", "anchor_id": "b", "allowed_effects": ["highlight", "draw_circle"]},
    "hero_rain_risk": {"target_id": "weather.day.0.hero_rain_risk", "anchor_id": "c", "allowed_effects": ["highlight", "draw_circle"]},
    "rain_risk": {"target_pattern": "weather.day.{day_index}.rain_risk", "entity_fields": ["day_index"], "anchor_id_pattern": "i{day_number}", "allowed_effects": ["highlight", "draw_circle"]},
    "wind": {"target_id": "weather.day.0.wind", "anchor_id": "d", "allowed_effects": ["highlight", "draw_circle"]},
    "temperature_trend": {"target_id": "weather.temperature_trend", "anchor_id": "e", "allowed_effects": ["highlight", "draw_circle"]},
    "weekly_rain_pattern": {"target_id": "weather.week.rain_pattern", "anchor_id": "g", "allowed_effects": ["highlight", "draw_circle"]},
    "temperature_peak": {"target_pattern": "weather.temperature_trend.point.{day_index}", "entity_fields": ["day_index"], "anchor_id_pattern": "f{day_number}", "allowed_effects": ["highlight", "draw_circle"]}
  },
  "data_capabilities": {
    "rain_probability": {"source_field": "rain_max_pct", "unit": "%", "focus": "rain_risk", "operations": ["lookup", "argmax", "argmin", "trend", "summary"]},
    "rain_amount": {"source_field": "rain_total_mm", "unit": "mm", "focus": "day_summary", "operations": ["lookup", "argmax", "argmin", "trend", "summary"]},
    "temperature_max": {"source_field": "max_c", "unit": "°C", "focus": "temperature_peak", "operations": ["lookup", "argmax", "argmin", "trend", "summary"]},
    "temperature_min": {"source_field": "min_c", "unit": "°C", "focus": "temperature_peak", "operations": ["lookup", "argmax", "argmin", "trend", "summary"]},
    "condition": {"focus": "weekly_rain_pattern", "operations": ["summary"]}
  },
  "extension_points": [
    {
      "slot": "metrics",
      "selector": "[data-slot='metrics']",
      "allowed_operations": ["insert_component", "replace_component"],
      "max_components": 6
    },
    {
      "slot": "footer",
      "selector": "[data-slot='footer']",
      "allowed_operations": ["insert_component", "replace_component"],
      "max_components": 2
    }
  ]
}
