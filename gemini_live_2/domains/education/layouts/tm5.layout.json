{
  "template_id": "tm5",
  "domain_id": "education",
  "description": "Panel with a title at the top, a centered panda image, and a descriptive text block below that lists the foods pandas eat.",
  "blocks": [
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 1,
        "col_span": 16,
        "row_span": 1
      },
      "props": {
        "content": "$block_1_content",
        "role": "title"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 5,
        "row": 3,
        "col_span": 8,
        "row_span": 6
      },
      "props": {
        "asset_id": "$block_2_asset_id"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 9,
        "col_span": 16,
        "row_span": 2
      },
      "props": {
        "content": "$block_3_content",
        "role": "body"
      },
      "initial_visibility": "visible"
    }
  ],
  "bindings": [
    {
      "key": "$block_1_content",
      "block_index": 1,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_2_asset_id",
      "block_index": 2,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_3_content",
      "block_index": 3,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    }
  ]
}
