{
  "template_id": "tm5",
  "domain_id": "education",
  "description": "A title at the top, followed by two large animal images side‑by‑side in the middle, and a hidden answer block below that reveals the correct English name when shown.",
  "blocks": [
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 1,
        "col_span": 16,
        "row_span": 1
      },
      "props": {
        "content": "$block_1_content",
        "role": "title"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 2,
        "row": 3,
        "col_span": 6,
        "row_span": 6
      },
      "props": {
        "asset_id": "$block_2_asset_id",
        "label": "$block_2_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 9,
        "row": 3,
        "col_span": 6,
        "row_span": 6
      },
      "props": {
        "asset_id": "$block_3_asset_id",
        "label": "$block_3_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "answer",
      "grid": {
        "col": 6,
        "row": 9,
        "col_span": 4,
        "row_span": 2
      },
      "props": {
        "value": "$block_4_value"
      },
      "initial_visibility": "hidden"
    }
  ],
  "bindings": [
    {
      "key": "$block_1_content",
      "block_index": 1,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_2_asset_id",
      "block_index": 2,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_2_label",
      "block_index": 2,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    },
    {
      "key": "$block_3_asset_id",
      "block_index": 3,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_3_label",
      "block_index": 3,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    },
    {
      "key": "$block_4_value",
      "block_index": 4,
      "prop_name": "value",
      "type": "string",
      "required": true,
      "description": "Đáp án hoặc từ ngắn cần hiển thị."
    }
  ]
}
