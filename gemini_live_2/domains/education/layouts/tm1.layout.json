{
  "template_id": "tm1",
  "domain_id": "education",
  "description": "Bài học cộng học sinh xem hai nhóm động vật (chó và mèo) với dấu cộng và dấu bằng, đáp án ẩn sẽ hiển thị khi Gemini Live bật.",
  "blocks": [
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 1,
        "col_span": 16,
        "row_span": 1
      },
      "props": {
        "content": "$block_1_content",
        "role": "title"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "object_group",
      "grid": {
        "col": 2,
        "row": 3,
        "col_span": 4,
        "row_span": 4
      },
      "props": {
        "asset_id": "$block_2_asset_id",
        "count": "$block_2_count",
        "label": "$block_2_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "text",
      "grid": {
        "col": 6,
        "row": 4,
        "col_span": 2,
        "row_span": 2
      },
      "props": {
        "content": "$block_3_content",
        "role": "label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "object_group",
      "grid": {
        "col": 8,
        "row": 3,
        "col_span": 4,
        "row_span": 4
      },
      "props": {
        "asset_id": "$block_4_asset_id",
        "count": "$block_4_count",
        "label": "$block_4_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "text",
      "grid": {
        "col": 12,
        "row": 4,
        "col_span": 2,
        "row_span": 2
      },
      "props": {
        "content": "$block_5_content",
        "role": "label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "answer",
      "grid": {
        "col": 14,
        "row": 3,
        "col_span": 2,
        "row_span": 4
      },
      "props": {
        "value": "$block_6_value"
      },
      "initial_visibility": "hidden"
    }
  ],
  "bindings": [
    {
      "key": "$block_1_content",
      "block_index": 1,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_2_asset_id",
      "block_index": 2,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset được lặp trong nhóm.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_2_count",
      "block_index": 2,
      "prop_name": "count",
      "type": "integer",
      "required": true,
      "description": "Số lượng bản sao của asset trong nhóm."
    },
    {
      "key": "$block_2_label",
      "block_index": 2,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho cả nhóm."
    },
    {
      "key": "$block_3_content",
      "block_index": 3,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_4_asset_id",
      "block_index": 4,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset được lặp trong nhóm.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_4_count",
      "block_index": 4,
      "prop_name": "count",
      "type": "integer",
      "required": true,
      "description": "Số lượng bản sao của asset trong nhóm."
    },
    {
      "key": "$block_4_label",
      "block_index": 4,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho cả nhóm."
    },
    {
      "key": "$block_5_content",
      "block_index": 5,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_6_value",
      "block_index": 6,
      "prop_name": "value",
      "type": "string",
      "required": true,
      "description": "Đáp án hoặc từ ngắn cần hiển thị."
    }
  ]
}
