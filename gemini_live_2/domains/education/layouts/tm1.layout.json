{
  "template_id": "tm1",
  "domain_id": "education",
  "description": "Bố cục đơn giản gồm tiêu đề ở trên, hình ảnh trung tâm, và đoạn văn kể chuyện ở dưới, phù hợp cho câu chuyện về động vật cho trẻ em.",
  "blocks": [
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 1,
        "col_span": 16,
        "row_span": 1
      },
      "props": {
        "content": "$block_1_content",
        "role": "title"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 4,
        "row": 2,
        "col_span": 8,
        "row_span": 4
      },
      "props": {
        "asset_id": "$block_2_asset_id",
        "label": "$block_2_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "text",
      "grid": {
        "col": 2,
        "row": 6,
        "col_span": 12,
        "row_span": 4
      },
      "props": {
        "content": "$block_3_content",
        "role": "body"
      },
      "initial_visibility": "visible"
    }
  ],
  "bindings": [
    {
      "key": "$block_1_content",
      "block_index": 1,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_2_asset_id",
      "block_index": 2,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_2_label",
      "block_index": 2,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    },
    {
      "key": "$block_3_content",
      "block_index": 3,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    }
  ]
}
