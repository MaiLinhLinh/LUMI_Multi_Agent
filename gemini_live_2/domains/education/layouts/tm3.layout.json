{
  "template_id": "tm3",
  "domain_id": "education",
  "description": "Ba hình ảnh của động vật được sắp xếp thành hình tam giác: một hình ở trên, hai hình ở dưới phía trái và phải.",
  "blocks": [
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 1,
        "col_span": 16,
        "row_span": 1
      },
      "props": {
        "content": "$block_1_content",
        "role": "title"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 6,
        "row": 2,
        "col_span": 6,
        "row_span": 4
      },
      "props": {
        "asset_id": "$block_2_asset_id",
        "label": "$block_2_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 2,
        "row": 6,
        "col_span": 6,
        "row_span": 4
      },
      "props": {
        "asset_id": "$block_3_asset_id",
        "label": "$block_3_label"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 10,
        "row": 6,
        "col_span": 6,
        "row_span": 4
      },
      "props": {
        "asset_id": "$block_4_asset_id",
        "label": "$block_4_label"
      },
      "initial_visibility": "visible"
    }
  ],
  "bindings": [
    {
      "key": "$block_1_content",
      "block_index": 1,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_2_asset_id",
      "block_index": 2,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_2_label",
      "block_index": 2,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    },
    {
      "key": "$block_3_asset_id",
      "block_index": 3,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_3_label",
      "block_index": 3,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    },
    {
      "key": "$block_4_asset_id",
      "block_index": 4,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_4_label",
      "block_index": 4,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    }
  ]
}
