{
  "template_id": "tm4",
  "domain_id": "education",
  "description": "Một trò chơi trốn tìm với mèo Miu: tiêu đề ở trên cùng, hình ảnh mèo ẩn ban đầu sẽ được hiển thị khi Gemini Live bật.",
  "blocks": [
    {
      "widget_id": "text",
      "grid": {
        "col": 1,
        "row": 1,
        "col_span": 16,
        "row_span": 1
      },
      "props": {
        "content": "$block_1_content",
        "role": "title"
      },
      "initial_visibility": "visible"
    },
    {
      "widget_id": "image",
      "grid": {
        "col": 4,
        "row": 3,
        "col_span": 9,
        "row_span": 6
      },
      "props": {
        "asset_id": "$block_2_asset_id",
        "label": "$block_2_label"
      },
      "initial_visibility": "hidden"
    }
  ],
  "bindings": [
    {
      "key": "$block_1_content",
      "block_index": 1,
      "prop_name": "content",
      "type": "string",
      "required": true,
      "description": "Nội dung văn bản cần hiển thị."
    },
    {
      "key": "$block_2_asset_id",
      "block_index": 2,
      "prop_name": "asset_id",
      "type": "string",
      "required": true,
      "description": "ID của asset ảnh sẽ hiển thị.",
      "source": "asset_catalog.id"
    },
    {
      "key": "$block_2_label",
      "block_index": 2,
      "prop_name": "label",
      "type": "string",
      "required": false,
      "description": "Nhãn ngắn cho ảnh."
    }
  ]
}
